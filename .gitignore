# 1. Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
*.pem
*.key
*.secret
*.cert

# 2. Dependencies
node_modules/
.pnp
.pnp.js

# 3. Production & Build Outputs
.next/
out/
build/
bin/
dist/

